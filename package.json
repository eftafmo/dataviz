{
  "name": "dataviz",
  "version": "0.9.0",
  "type": "module",
  "description": "EEA & Norway grants data and results portal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eftfmo/dataviz.git"
  },
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open --e2e",
    "dev": "vite",
    "lint": "run-s lint:css lint:js",
    "lint:check": "run-s lint:css:check lint:js:check",
    "lint:js": "eslint --fix \"assets/**/*.js\" \"assets/**/*.vue\"",
    "lint:js:check": "eslint \"assets/**/*.js\" \"assets/**/*.vue\"",
    "lint:css": "prettier --write -c assets/css/",
    "lint:css:check": "prettier --check -c assets/css/",
    "build": "vite build",
    "serve": "vite preview"
  },
  "browserslist": [
    "IE >= 9",
    "last 2 versions",
    "> 5%"
  ],
  "dependencies": {
    "clipboard": "2.0.11",
    "d3": "7.9.0",
    "d3-tip": "0.9.1",
    "lodash.debounce": "4.0.8",
    "lodash.merge": "4.6.2",
    "lodash.orderby": "4.18.0",
    "normalize.css": "8.0.1",
    "popper.js": "1.16.1",
    "vite-plugin-json5": "1.4.4",
    "vue": "3.5.35",
    "vue3-tabs-component": "1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@rollup/pluginutils": "5.4.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/compiler-sfc": "3.5.35",
    "@vue/eslint-config-prettier": "10.2.0",
    "autoprefixer": "10.5.0",
    "cypress": "15.16.0",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "6.4.1",
    "eslint-plugin-mocha": "11.3.0",
    "eslint-plugin-prettier-vue": "5.0.0",
    "eslint-plugin-vue": "10.9.1",
    "glob": "13.0.6",
    "json5": "2.2.3",
    "less": "4.6.4",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.3",
    "topojson-client": "3.1.0",
    "vite": "8.0.16"
  }
}
